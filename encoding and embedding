# MAIN EXECUTION
# =====================================================================

if __name__ == "__main__":
    print("\nStarting Encoding & Embedding Demonstrations...\n")
    
    # Run Encoding Demos
    demo_label_encoding()
    demo_one_hot_encoding()
    demo_ordinal_encoding()
    demo_target_encoding()
    
    # Run Embedding Demos
    demo_tfidf()
